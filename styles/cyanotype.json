{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Cyanotype",
	"description": "Blueprint blue. A cyanotype duotone over the photos, a cool paper page and deep-blue chrome.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "mist",        "color": "#dde3eb", "name": "Mist (page background)" },
				{ "slug": "white",       "color": "#eef2f7", "name": "White (surface)" },
				{ "slug": "ink",         "color": "#182634", "name": "Ink (chrome)" },
				{ "slug": "fg",          "color": "#18242f", "name": "Foreground (body text)" },
				{ "slug": "muted",       "color": "#4c5c6d", "name": "Muted (meta / EXIF)" },
				{ "slug": "faint",       "color": "#7d8c9c", "name": "Faint (placeholder / disabled)" },
				{ "slug": "on-ink",      "color": "#dfe7f0", "name": "On ink (text on chrome)" },
				{ "slug": "hairline",    "color": "#c4cfdb", "name": "Hairline (borders)" },
				{ "slug": "pink",        "color": "#2c6f9c", "name": "Accent / focus / active" },
				{ "slug": "pink-action", "color": "#235f86", "name": "Action bg" },
				{ "slug": "blue",        "color": "#235f86", "name": "Link" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--fg)" },
		"css": ".wp-site-blocks{--glmr-link-hover:#18435f;--glmr-on-ink-soft:rgba(223,231,240,.66);--glmr-on-ink-muted:rgba(223,231,240,.58);--glmr-on-ink-faint:rgba(223,231,240,.42);--glmr-ink-field-bg:rgba(223,231,240,.1);--glmr-ink-field-border:rgba(223,231,240,.22);--glmr-ink-rule:rgba(223,231,240,.16)}",
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "#18435f" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--pink-action)", "text": "#ffffff" },
				":hover": { "color": { "background": "#18435f", "text": "#ffffff" } }
			}
		},
		"blocks": {
			"core/image": { "filter": { "duotone": "var:preset|duotone|cyan" } },
			"core/cover": { "filter": { "duotone": "var:preset|duotone|cyan" } },
			"core/post-featured-image": { "filter": { "duotone": "var:preset|duotone|cyan" } }
		}
	}
}
