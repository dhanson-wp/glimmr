{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Silver",
	"description": "Black-and-white. A grayscale duotone maps every photo to ink and light; the chrome stays bright.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "mist",        "color": "#ececed", "name": "Mist (page background)" },
				{ "slug": "white",       "color": "#ffffff", "name": "White (surface)" },
				{ "slug": "ink",         "color": "#393940", "name": "Ink (chrome)" },
				{ "slug": "fg",          "color": "#1b1b1e", "name": "Foreground (body text)" },
				{ "slug": "muted",       "color": "#5d5d63", "name": "Muted (meta / EXIF)" },
				{ "slug": "faint",       "color": "#909097", "name": "Faint (placeholder / disabled)" },
				{ "slug": "on-ink",      "color": "#f1f1f2", "name": "On ink (text on chrome)" },
				{ "slug": "hairline",    "color": "#d6d6d9", "name": "Hairline (borders)" },
				{ "slug": "pink",        "color": "#6c6c74", "name": "Accent / focus / active" },
				{ "slug": "pink-action", "color": "#4c4c53", "name": "Action bg" },
				{ "slug": "blue",        "color": "#4c4c53", "name": "Link" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--fg)" },
		"css": ".wp-site-blocks{--glmr-link-hover:#2e2e33;--glmr-on-ink-soft:rgba(241,241,242,.66);--glmr-on-ink-muted:rgba(241,241,242,.58);--glmr-on-ink-faint:rgba(241,241,242,.42);--glmr-ink-field-bg:rgba(241,241,242,.1);--glmr-ink-field-border:rgba(241,241,242,.22);--glmr-ink-rule:rgba(241,241,242,.16)}",
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "#2e2e33" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--pink-action)", "text": "#ffffff" },
				":hover": { "color": { "background": "#2e2e33", "text": "#ffffff" } }
			}
		},
		"blocks": {
			"core/image": { "filter": { "duotone": "var:preset|duotone|silver" } },
			"core/cover": { "filter": { "duotone": "var:preset|duotone|silver" } },
			"core/post-featured-image": { "filter": { "duotone": "var:preset|duotone|silver" } }
		}
	}
}
