{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"description": "The dark room. Near-black chrome and surfaces, a brighter pink, photos glowing against the dark.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "mist",        "color": "#161618", "name": "Mist (page background)" },
				{ "slug": "white",       "color": "#2b2b2e", "name": "White (surface)" },
				{ "slug": "ink",         "color": "#0e0e10", "name": "Ink (chrome)" },
				{ "slug": "fg",          "color": "#f3f5f6", "name": "Foreground (body text)" },
				{ "slug": "muted",       "color": "#9a9a9c", "name": "Muted (meta / EXIF)" },
				{ "slug": "faint",       "color": "#6f6f72", "name": "Faint (placeholder / disabled)" },
				{ "slug": "on-ink",      "color": "#f3f5f6", "name": "On ink (text on chrome)" },
				{ "slug": "hairline",    "color": "#38383a", "name": "Hairline (borders)" },
				{ "slug": "pink",        "color": "#ff3da0", "name": "Glimmr Pink (accent / focus / active)" },
				{ "slug": "pink-action", "color": "#ff3da0", "name": "Pink action (button bg)" },
				{ "slug": "blue",        "color": "#5cb8ff", "name": "Link blue" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--fg)" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "#9ad4ff" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--pink)", "text": "#161618" },
				":hover": { "color": { "background": "#ff70bb", "text": "#161618" } }
			}
		}
	}
}
