{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"description": "The dark room. Near-black chrome and surfaces, a brighter pink, photos glowing against the dark.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "mist",        "color": "#1c1c1f", "name": "Mist (page background)" },
				{ "slug": "white",       "color": "#2b2b2e", "name": "White (surface)" },
				{ "slug": "ink",         "color": "#141416", "name": "Ink (chrome)" },
				{ "slug": "fg",          "color": "#f3f5f6", "name": "Foreground (body text)" },
				{ "slug": "muted",       "color": "#b4b4b8", "name": "Muted (meta / EXIF)" },
				{ "slug": "faint",       "color": "#7e7e84", "name": "Faint (placeholder / disabled)" },
				{ "slug": "on-ink",      "color": "#f3f5f6", "name": "On ink (text on chrome)" },
				{ "slug": "hairline",    "color": "#38383a", "name": "Hairline (borders)" },
				{ "slug": "pink",        "color": "#ff3da0", "name": "Glimmr Pink (accent / focus / active)" },
				{ "slug": "pink-action", "color": "#ff3da0", "name": "Pink action (button bg)" },
				{ "slug": "blue",        "color": "#5cb8ff", "name": "Link blue" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--fg)" },
		"css": ".wp-site-blocks{--glmr-link-hover:#8fd0ff;--glmr-on-ink-soft:rgba(243,245,246,.6);--glmr-on-ink-muted:rgba(243,245,246,.5);--glmr-on-ink-faint:rgba(243,245,246,.42);--glmr-ink-field-bg:rgba(243,245,246,.1);--glmr-ink-field-border:rgba(243,245,246,.22);--glmr-ink-rule:rgba(243,245,246,.16)}",
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "#8fd0ff" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--pink)", "text": "#1a0010" },
				":hover": { "color": { "background": "#ff70bb", "text": "#1a0010" } }
			}
		}
	}
}
