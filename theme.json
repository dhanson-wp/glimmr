{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1060px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "customDuotone": true,
      "palette": [
        { "slug": "mist",        "color": "#f3f5f6", "name": "Mist (page background)" },
        { "slug": "white",       "color": "#ffffff", "name": "White (surface)" },
        { "slug": "ink",         "color": "#212124", "name": "Ink (chrome)" },
        { "slug": "fg",          "color": "#101012", "name": "Foreground (body text)" },
        { "slug": "muted",       "color": "#5c5c5c", "name": "Muted (meta / EXIF)" },
        { "slug": "faint",       "color": "#898989", "name": "Faint (placeholder / disabled)" },
        { "slug": "on-ink",      "color": "#f3f5f6", "name": "On ink (text on chrome)" },
        { "slug": "hairline",    "color": "#dddddd", "name": "Hairline (borders)" },
        { "slug": "pink",        "color": "#ff0084", "name": "Glimmr Pink (accent / focus / active)" },
        { "slug": "pink-action", "color": "#d1006e", "name": "Pink action (button bg, AA on white)" },
        { "slug": "blue",        "color": "#0063a8", "name": "Link blue" }
      ],
      "duotone": [
        { "slug": "silver", "name": "Silver",    "colors": ["#121314", "#f3f4f4"] },
        { "slug": "sepia",  "name": "Sepia",     "colors": ["#2e1c0f", "#f7e6ba"] },
        { "slug": "cyan",   "name": "Cyanotype", "colors": ["#0a1f4a", "#c4f0fc"] }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Figtree",
          "fontFamily": "Figtree, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
          "fontFace": [
            { "fontFamily": "Figtree", "fontWeight": "300 700", "fontStyle": "normal", "fontStretch": "normal", "src": ["file:./assets/fonts/figtree-variable.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "chip",     "name": "Chip (11–12)",       "size": "clamp(0.6875rem, 0.66rem + 0.1vw, 0.75rem)", "fluid": false },
        { "slug": "meta",     "name": "Meta (12–14)",       "size": "clamp(0.75rem, 0.72rem + 0.2vw, 0.875rem)",  "fluid": false },
        { "slug": "base",     "name": "Body (14–16)",       "size": "clamp(0.875rem, 0.84rem + 0.3vw, 1rem)",     "fluid": false },
        { "slug": "large",    "name": "Card title (16–20)", "size": "clamp(1rem, 0.94rem + 0.5vw, 1.25rem)",      "fluid": false },
        { "slug": "x-large",  "name": "Heading (24–36)",    "size": "clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem)",     "fluid": false },
        { "slug": "xx-large", "name": "Hero (36–52)",       "size": "clamp(2.25rem, 1.6rem + 2.6vw, 3.25rem)",    "fluid": false }
      ],
      "fontWeight": true,
      "lineHeight": true,
      "letterSpacing": true,
      "fluid": true
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "1 · 4px",   "size": "4px" },
        { "slug": "20", "name": "2 · 8px",   "size": "8px" },
        { "slug": "30", "name": "3 · 16px",  "size": "16px" },
        { "slug": "40", "name": "4 · 24px",  "size": "24px" },
        { "slug": "50", "name": "5 · 48px",  "size": "48px" },
        { "slug": "60", "name": "6 · 96px",  "size": "96px" },
        { "slug": "70", "name": "7 · 160px", "size": "160px" }
      ]
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "sm",    "name": "Hover lift", "shadow": "rgba(0,0,0,0.20) 0 1px 4px 0" },
        { "slug": "md",    "name": "Dropdown",   "shadow": "rgba(0,0,0,0.20) 0 3px 6px -1px" },
        { "slug": "lg",    "name": "Modal",      "shadow": "rgba(0,0,0,0.50) 0 2px 8px 0" },
        { "slug": "inset", "name": "Media edge", "shadow": "rgba(0,0,0,0.08) 0 0 20px 0 inset" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--fg)" },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)",
      "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--blue)" },
        ":hover": { "color": { "text": "#004f86" } },
        ":focus": { "outline": { "color": "var(--wp--preset--color--pink)", "width": "2px", "style": "solid", "offset": "2px" } }
      },
      "heading": { "typography": { "fontWeight": "300", "lineHeight": "1.1", "letterSpacing": "-0.01em" } },
      "h3": { "typography": { "fontWeight": "600", "lineHeight": "1.3" } },
      "h4": { "typography": { "fontWeight": "600" } },
      "h5": { "typography": { "fontWeight": "600", "textTransform": "uppercase", "letterSpacing": "0.06em" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--pink-action)", "text": "#ffffff" },
        "border": { "radius": "3px" },
        "typography": { "fontWeight": "600" },
        "spacing": { "padding": { "top": "10px", "bottom": "10px", "left": "18px", "right": "18px" } },
        ":hover": { "color": { "background": "#b3005e", "text": "#ffffff" } },
        ":focus": { "outline": { "color": "var(--wp--preset--color--pink)", "width": "2px", "style": "solid", "offset": "2px" } }
      }
    },
    "blocks": {
      "core/image": { "border": { "radius": "0px" } },
      "core/post-featured-image": { "border": { "radius": "0px" } },
      "core/site-title": { "typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--large)" } },
      "core/post-terms": { "typography": { "fontSize": "var(--wp--preset--font-size--meta)" }, "color": { "text": "var(--wp--preset--color--muted)" } },
      "core/query-pagination": { "typography": { "fontSize": "var(--wp--preset--font-size--meta)" } },
      "core/search": {
        "css": "& .wp-block-search__input{border-radius:3px;border:1px solid var(--wp--preset--color--hairline)}"
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-link-in-bio", "title": "Link in bio", "postTypes": ["page"] }
  ]
}
